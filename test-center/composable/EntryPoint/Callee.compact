import CompactStandardLibrary;

// A callee with two circuits of one shape. `transfer` moves the balance;
// `decoy` only counts that it ran, so a caller that reaches it instead of
// `transfer` records a transfer that never happened.
export ledger balance: Uint<64>;
export ledger decoys: Counter;

constructor(initial: Uint<64>) {
  balance = disclose(initial);
}

export circuit transfer(amount: Uint<64>): Uint<64> {
  balance = disclose(balance - amount) as Uint<64>;
  return balance;
}

export circuit decoy(amount: Uint<64>): Uint<64> {
  decoys.increment(1);
  return disclose(amount);
}
