import CompactStandardLibrary;

// Declares both of the callee's circuits, so a module that has been edited to
// call `decoy` still conforms to the declaration and only the proof can tell.
contract Callee {
  circuit transfer(amount: Uint<64>): Uint<64>;
  circuit decoy(amount: Uint<64>): Uint<64>;
}

export ledger callee: Callee;
export ledger payments: Counter;

constructor(c: Callee) {
  callee = disclose(c);
}

export circuit pay(amount: Uint<64>): Uint<64> {
  const remaining = callee.transfer(disclose(amount));
  payments.increment(1);
  return remaining;
}
