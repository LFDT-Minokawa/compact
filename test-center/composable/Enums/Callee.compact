import CompactStandardLibrary;

export enum Order { Open, Filled(Bytes<32>, Uint<64>), Cancelled(Bytes<32>) }

export ledger last: Order;
export ledger note: Maybe<Field>;

export circuit place(o: Order, m: Maybe<Field>): Either<Order, Field> {
  last = disclose(o);
  note = disclose(m);
  return match disclose(m) {
    Some(n) => Either<Order, Field>::Right(n),
    None    => Either<Order, Field>::Left(disclose(o)),
  };
}
