// A callee with a capsule of its own: a local constructor, local books, and a host function.

import CompactStandardLibrary;

host vendor:capsule/tally@1.0.0 {
  weight(): Uint<16>;
}

export ledger visitors: Counter;

export local visits: Counter;
export local joined: Boolean;

local constructor {
  joined = true;
}

local tally(w: Uint<16>): Uint<64> {
  visits.increment(w);
  return visits;
}

export circuit visit(): Uint<64> {
  visitors.increment(1);
  return disclose(tally(weight()));
}

export circuit hasJoined(): Boolean {
  visitors.increment(1);
  return disclose(joined);
}
