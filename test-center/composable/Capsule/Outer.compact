// A caller without local state of its own, so the callee's capsule is the only one in play.

import CompactStandardLibrary;

contract Inner {
  circuit visit(): Uint<64>;
  circuit hasJoined(): Boolean;
}

export ledger inner: Inner;
export ledger lastCount: Uint<64>;

constructor(i: Inner) {
  inner = disclose(i);
}

export circuit visitOnce(): Uint<64> {
  const c = inner.visit();
  lastCount = c;
  return c;
}

export circuit visitTwice(): Uint<64> {
  inner.visit();
  const c = inner.visit();
  lastCount = c;
  return c;
}

export circuit checkJoined(): Boolean {
  return inner.hasJoined();
}
