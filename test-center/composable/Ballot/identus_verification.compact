// The direction document's vendor module: a credential vendor publishes a host interface as an
// ordinary module, which a contract includes and imports.

module identus_verification {
  export struct SignedDate {
    date: Uint<64>;
    issuer: Bytes<32>;
    signature: Bytes<64>;
  }

  export host identus:verification/age@1.2.0 {
    ageCredential(): SignedDate;
  }
}
