// The direction document's registry: the callee, deployed by someone else and discovered at run
// time, keeping its own private books while being called from another contract.

import CompactStandardLibrary;

// public membership set
export ledger members: MerkleTree<10, Bytes<32>>;

// this party's private record, starting at its default: no local constructor needed
export local myEnrollments: Set<Bytes<32>>;

// a local write that runs even when this contract is a callee
local remember(c: Bytes<32>): [] {
  myEnrollments.insert(c);
}

// an unbounded scan off chain, a bounded result for the circuit
local proofFor(c: Bytes<32>): MerkleTreePath<10, Bytes<32>> {
  assert(myEnrollments.member(c), "not enrolled here");
  const path = members.findPathForLeaf(c);
  assert(path.is_some, "not in the tree");
  return path.value;
}

export circuit enroll(commitment: Bytes<32>): [] {
  // ledger: public, proven, replayed
  members.insert(disclose(commitment));
  // local: private, recorded, replayable
  remember(commitment);
}

export circuit proveMembership(commitment: Bytes<32>): [] {
  const path = proofFor(commitment);
  // soundness stays in the circuit
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "not a member");
}
