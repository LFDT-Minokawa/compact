import CompactStandardLibrary;

// An outbox: every call takes the next sequence number and a snapshot of the
// highest response height seen so far; every response raises that height.
// None of these circuits reads the shared counters, so none of them conflicts
// with another landing first.
export ledger nonces: StampedCounter<Uint<64>>;
export ledger seen: StampedCounter<Uint<64>>;

export circuit call(k: Uint<64>): [] {
  nonces.stamp(disclose(k));
  nonces.increment(1);
  seen.stamp(disclose(k));
}

export circuit respond(k: Uint<64>, height: Uint<64>): [] {
  assert(nonces.member(disclose(k)), "unknown key");
  seen.raiseTo(disclose(height));
  nonces.remove(disclose(k));
  seen.remove(disclose(k));
}

export circuit nonceOf(k: Uint<64>): Uint<64> {
  return nonces.lookup(disclose(k));
}

export circuit seenAt(k: Uint<64>): Uint<64> {
  return seen.lookup(disclose(k));
}

export circuit isStamped(k: Uint<64>): Boolean {
  return nonces.member(disclose(k));
}

export circuit nonce(): Uint<64> {
  return nonces.value();
}

export circuit lastSeen(): Uint<64> {
  return seen.value();
}

export circuit reset(): [] {
  nonces.resetToDefault();
  seen.resetToDefault();
}
