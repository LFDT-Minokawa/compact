{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "types": ["vitest/globals"],
    "paths": { "@/*":  ["./src/*"], "@": ["./src/index.ts"]}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/fuzzer/**/*", "src/resources/**/*"]
}
