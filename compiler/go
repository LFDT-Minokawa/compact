set -o errexit
set -o nounset

# on macos chez scheme is usually available as chez on linux as scheme
if command -v scheme &> /dev/null
then
   SCHEME=scheme
else
   SCHEME=chez
fi

if [ $# == 1 ]
then
  if [ "$1" == "--help" ]
  then
    program=`basename $0`
    echo "usage: $program                           # recompile compiler as needed, then run tests"
    echo "       $program --rebuild                 # recompile entire compiler, then run tests"
    echo "       $program --build-for-all-targets   # recompile and run tests for each target in compiler/targets"
    echo "       $program --help                    # show this message"
    echo "   NB: use --rebuild for complete coverage info and stats"
    echo "   NB: without --build-for-all-targets only the target on CHEZSCHEMELIBDIRS is tested"
    exit
  elif [ "$1" == "--rebuild" ]
  then
    rm -rf obj/profiled-compiler
  elif [ "$1" == "--build-for-all-targets" ]
  then
    # Run the tests, from scratch, once per target directory.  The target a
    # build uses is the compiler/targets/<target> directory on CHEZSCHEMELIBDIRS,
    # and object files of different targets share names, hence --rebuild.  Each
    # run regenerates doc/ledger-adt-<target>.mdx.  The coverage report left
    # behind is that of the last target.
    if ! echo "${CHEZSCHEMELIBDIRS:-}" | tr ':' '\n' | grep -q '^compiler/targets/'
    then
      echo "error: CHEZSCHEMELIBDIRS has no compiler/targets/<target> entry to replace with each target" >&2
      echo "       the targets are: `ls compiler/targets | tr '\n' ' '`" >&2
      exit 1
    fi
    status=0
    for target_dir in compiler/targets/*/
    do
      target=`basename "$target_dir"`
      echo "====================== TARGET $target ========================"
      CHEZSCHEMELIBDIRS=`echo "$CHEZSCHEMELIBDIRS" | sed -E "s|compiler/targets/[^:]+|compiler/targets/$target|g"` \
        "$0" --rebuild || status=1
    done
    exit $status
  else
    exec $0 --help
  fi
fi

# The target of this run is the compiler/targets/<target> directory on
# CHEZSCHEMELIBDIRS.  Say so here when there is none, instead of leaving it to
# scheme to fail with some more obscure message.
target_dirs=`echo "${CHEZSCHEMELIBDIRS:-}" | tr ':' '\n' | grep '^compiler/targets/' || true`
if [ -z "$target_dirs" ]
then
  echo "error: CHEZSCHEMELIBDIRS has no compiler/targets/<target> entry, so there is no target to test" >&2
  echo "       the targets are: `ls compiler/targets | tr '\n' ' '`" >&2
  exit 1
fi

rm -rf coverage
mkdir coverage

# enable profiling only for portions # of the code exercised by the compiler
# proper, effectively excluding, e.g., all of the nanopass infrastructure
# except macro-generated forms.
"$SCHEME" -q << END || exit
(reset-handler abort)
(keyboard-interrupt-handler (lambda () (reset)))
(print-extended-identifiers #t)
(library-directories
  ; redirect compiler object code to obj/profiled-compiler, leaving obj/compiler
  ; for unprofiled code produced by compiling compiler/compactc.ss
  (let f ([a* (library-directories)])
    (assert (not (null? a*)))
    (map
      (lambda (a)
        (if (equal? (cdr a) "obj/compiler")
            (cons (car a) "obj/profiled-compiler")
            a))
      a*)))
(compile-library-handler
  ; enable profiling for and only for code redirected to obj/profiled-compiler
  (lambda (src-path obj-path)
    (parameterize ([compile-profile
                    (and (string=? (path-first obj-path) "obj")
                         (string=? (path-first (path-rest obj-path)) "profiled-compiler"))])
      (when (compile-profile)
        (printf "compiling w/profiling ~a to ~a\n" src-path obj-path))
      (compile-library src-path obj-path))))
(compile-imported-libraries #t)
(debug-level 3)
(library (go)
  (export failed)
  (import (chezscheme))
  ; failed is set upon failure to #t by test.ss
  (define failed (make-parameter #f)))
(printf "====================== START OF UNIT TESTS ========================\n")
(load "compiler/test.ss")
(collect (collect-maximum-generation))
(unless (file-directory? "coverage") (mkdir "coverage"))
(profile-dump-html "coverage/")
(let ([ls (filter (lambda (x) (equal? (path-first (cadr x)) "compiler")) (profile-dump-list))])
  (let ([total (length ls)]
        [hit (fold-left (lambda (hit x) (if (> (car x) 0) (+ hit 1) hit)) 0 ls)])
    (printf "======== END OF UNIT TESTS. COVERAGE = ~d% (~d/~d). ========\n"
      (if (= total 0) 0 (round (* 100 (/ hit total))))
      hit
      total)))
(exit (if (let () (import (go)) (failed)) 1 0))
END
