pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger lastDigest: Bytes<32>;

constructor() {
  lastDigest = default<Bytes<32>>;
  withZkir = false;
}


export circuit hashField(value: Field): Bytes<32> {
  return disclose(keccak256<Field>(value));
}

export circuit hashVector3(value: Vector<3, Field>): Bytes<32> {
  return disclose(keccak256<Vector<3, Field>>(value));
}

export circuit hashFieldAndStore(value: Field): Bytes<32> {
  const digest: Bytes<32> = keccak256<Field>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashVector3AndStore(value: Vector<3, Field>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Vector<3, Field>>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}

// Three equal 4-byte fields: flattens to 12 bytes.
struct Triple { a: Bytes<4>, b: Bytes<4>, c: Bytes<4> }

// Unequal field sizes that still sum to 12 bytes: flattens to the SAME 12 bytes
// as `Triple` / `Bytes<12>`, proving the digest ignores where the field
// boundaries fall.
struct Uneven { head: Bytes<1>, mid: Bytes<4>, tail: Bytes<7> }

export circuit hashBytes12(x: Bytes<12>): Bytes<32> {
  return disclose(keccak256<Bytes<12>>(x));
}

export circuit hashTriple(t: Triple): Bytes<32> {
  return disclose(keccak256<Triple>(t));
}

export circuit hashUneven(u: Uneven): Bytes<32> {
  return disclose(keccak256<Uneven>(u));
}

// Touching this ledger flag is what makes `hashBytes` provable and pulls the
// keccak256 into zkir.
export ledger withZkir: Boolean;

export circuit hashBytes(value: Bytes<32>): Bytes<32> {
  withZkir = true;
  return disclose(keccak256<Bytes<32>>(value));
}

// 1 = the minimal width: a single byte.
export circuit hashAndStore1(value: Bytes<1>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Bytes<1>>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}

// 32..63 (spread across the chunk contracts) — EVERY width from the digest
// width (32) through one byte past the 2x31 = 62 field-element packing
// boundary (63); 33 is also the compressed secp256k1 public-key length.
export circuit hashAndStore32(value: Bytes<32>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Bytes<32>>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}

