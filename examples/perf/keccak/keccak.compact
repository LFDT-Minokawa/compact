// ordinary-types-keccak256.compact — the RUNTIME (prove + verify) sibling of
// types-keccak256.compact. keccak256 accepts any ORDINARY Compact type; this
// contract proves that the IN-CIRCUIT (zkir-v3) digest of such a type matches
// the OFF-CIRCUIT digest the Compact JS runtime computes for the SAME value,
// for the composite / non-`Bytes`, non-`Field` shapes:
//
//   * Boolean
//   * Uint<64>
//   * Vector<3, Boolean>
//   * a custom enum (`Direction`)                    — lowers to a bounded Uint
//   * a custom struct `Parcel { a: Boolean, b: Uint<8>, c: Direction }`
//   * Vector<3, Parcel>
//
// WHY these types: `types-keccak256.compact` already covers them OFF-chain
// (shape / determinism / distinctness) and `field-keccak256.compact` covers the
// prove+verify path for `Field` / `Vector<Field>`. The gap this closes is the
// prove+verify path for the ORDINARY COMPOSITE types — structs and enums flatten
// to a non-trivial field-aligned layout, exactly where the in-circuit flattening
// is most likely to diverge from the JS runtime's `toBinaryRepr`. An enum is an
// ordinary value type (it lowers to a bounded unsigned integer), so keccak256
// accepts it — unlike an ADT such as `Counter` (see adt-keccak256.compact).
//
// HOW the case checks it (see src/cases/runtime/ordinary-types.ts): the driver
// takes the OFF-circuit digest from the PURE circuit below (`pureCircuits.*`,
// computed in JS with no proof and no ledger), then submits the matching
// `*AndStore` RUNTIME circuit as a real proven call. The `*AndStore` circuit
// writes its digest to the shared `lastDigest` ledger field, which (1) makes the
// circuit provable so keccak enters zkir, and (2) gives the driver an indexed
// on-chain value to read back. A successful prove + verify whose indexed digest
// equals the pure digest IS the "off-circuit == in-circuit" match: if the
// in-circuit keccak disagreed with the JS keccak, the proof would be
// unsatisfiable (the ledger write is pinned to the JS value) and the call would
// fail at prove time.
//
// Because the runtime circuits are provable, the whole contract compiles WITH
// `--feature-zkir-v3` (the pure circuits stay off-chain regardless — purity is
// per-circuit). Same branch toolchain as the other keccak cases: a compactc that
// knows keccak256 + compact-runtime >= 0.16.101. See README / RUNNING.md.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// A custom enum. `replace-enums` lowers it to a bounded unsigned integer, an
// ORDINARY (flattenable) type, so keccak256 accepts it. In the JS bindings its
// values are the plain numbers 0..3 (North=0, East=1, South=2, West=3).
enum Direction {
  North,
  East,
  South,
  West
}

// A custom struct mixing a Boolean, a Uint<8>, and the enum — the shape the test
// plan calls out. Flattens field-by-field, in declaration order.
struct Parcel {
  a: Boolean,
  b: Uint<8>,
  c: Direction
}

// --- PURE (off-chain) — the off-circuit digest oracle ----------------------
// These never touch the ledger, so they stay off-chain (pure) even
// though the contract compiles with `--feature-zkir-v3`.

export circuit hashBool(x: Boolean): Bytes<32> {
  return disclose(keccak256<Boolean>(x));
}

export circuit hashUint(x: Uint<64>): Bytes<32> {
  return disclose(keccak256<Uint<64>>(x));
}

export circuit hashVecBool(x: Vector<3, Boolean>): Bytes<32> {
  return disclose(keccak256<Vector<3, Boolean>>(x));
}

export circuit hashEnum(x: Direction): Bytes<32> {
  return disclose(keccak256<Direction>(x));
}

export circuit hashStruct(x: Parcel): Bytes<32> {
  return disclose(keccak256<Parcel>(x));
}

export circuit hashVecStruct(x: Vector<3, Parcel>): Bytes<32> {
  return disclose(keccak256<Vector<3, Parcel>>(x));
}

// --- RUNTIME (ledger-touching → provable under --feature-zkir-v3) ----------
// Each writes its digest to `lastDigest`, which makes the circuit provable (the
// keccak enters zkir) and gives the driver an indexed on-chain digest to read.

export circuit hashBoolAndStore(x: Boolean): Bytes<32> {
  const digest: Bytes<32> = keccak256<Boolean>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashUintAndStore(x: Uint<64>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Uint<64>>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashVecBoolAndStore(x: Vector<3, Boolean>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Vector<3, Boolean>>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashEnumAndStore(x: Direction): Bytes<32> {
  const digest: Bytes<32> = keccak256<Direction>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashStructAndStore(x: Parcel): Bytes<32> {
  const digest: Bytes<32> = keccak256<Parcel>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashVecStructAndStore(x: Vector<3, Parcel>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Vector<3, Parcel>>(x);
  lastDigest = disclose(digest);
  return disclose(digest);
}

export circuit hashAndStore(value: Bytes<32>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Bytes<32>>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}

// 0 = the empty input: keccak256 of zero bytes.
export circuit hashBytes0(value: Bytes<0>): Bytes<32> {
  return disclose(keccak256<Bytes<0>>(value));
}

// 1 = the "1 zero byte" vector.
export circuit hashBytes1(value: Bytes<1>): Bytes<32> {
  return disclose(keccak256<Bytes<1>>(value));
}

// 2 = the "2 zero bytes" vector.
export circuit hashBytes2(value: Bytes<2>): Bytes<32> {
  return disclose(keccak256<Bytes<2>>(value));
}

// 4 = "test".
export circuit hashBytes4(value: Bytes<4>): Bytes<32> {
  return disclose(keccak256<Bytes<4>>(value));
}

// 5 = the "5 zero bytes" vector.
export circuit hashBytes5(value: Bytes<5>): Bytes<32> {
  return disclose(keccak256<Bytes<5>>(value));
}

// 10 = the "10 zero bytes" vector.
export circuit hashBytes10(value: Bytes<10>): Bytes<32> {
  return disclose(keccak256<Bytes<10>>(value));
}

// 18 = "longer test string".
export circuit hashBytes18(value: Bytes<18>): Bytes<32> {
  return disclose(keccak256<Bytes<18>>(value));
}

// types-keccak256.compact — keccak256 accepts any ORDINARY Compact type, not
// just `Bytes<N>`. The keccak256 test plan asks for coverage that each such
// type hashes to a 32-byte digest and is deterministic: `Field`, `Bytes<N>`,
// `Boolean`, `Uint<N>`, `Vector`, and a struct. (ADT types like `Counter` are
// rejected — see adt-keccak256.compact.)
//
// These are PURE circuits (no ledger state), computed off-chain by the Compact JS
// runtime (`pureCircuits.*`); the case asserts shape (32 bytes), determinism
// (same input → same digest), and distinctness (different inputs → different
// digests) rather than fixed vectors, because the per-type flattened encoding is
// an internal detail. Pure → never enters zkir → compiles WITHOUT
// `--feature-zkir-v3`. Branch toolchain required (see README).

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

struct Mixed {
  tag: Bytes<8>,
  count: Uint<64>,
  flag: Boolean,
}

export circuit hashVector(x: Vector<4, Field>): Bytes<32> {
  return disclose(keccak256<Vector<4, Field>>(x));
}

