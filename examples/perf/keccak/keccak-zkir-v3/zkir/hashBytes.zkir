{
  "version": { "major": 3, "minor": 0 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%value.0", "type": "Scalar<BLS12-381>" },
    { "name": "%value.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>",
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%value.0", "bits": 8 },
    { "op": "constrain_bits", "val": "%value.1", "bits": 248 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "keccak256", "output": "%bytes.2", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%value.0", "%value.1"] },
    { "op": "bytes32_into_low_high", "outputs": ["%t.3", "%t.4"], "bytes": "%bytes.2" },
    { "op": "output", "vals": ["%t.4", "%t.3"] }
  ]
}
