pragma language_version >= 0.25.0;

import CompactStandardLibrary;

module condSwap<#N> {

  export ledger tree: MerkleTree<N, Field>;

  witness findPath(leaf: Field): MerkleTreePath<N, Field>;

  export circuit insertLeaf(leaf: Field): [] {
    tree.insert(leaf);
  }

  export circuit verifyMembership(leaf: Field): [] {
    const path = findPath(leaf);
    assert(tree.checkRoot(disclose(merkleTreePathRoot<N, Field>(path))) &&
           leaf == path.leaf,
           "merkle path not recognized by public state");
  }

  export circuit pathRootOnly(path: MerkleTreePath<N, Bytes<32>>): MerkleTreeDigest {
    return merkleTreePathRootNoLeafHash<N>(path);
  }
}

import condSwap<32>;

export { verifyMembership, pathRootOnly }
