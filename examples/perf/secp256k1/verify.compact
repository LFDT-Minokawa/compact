//
// verify-secp256k1.compact — exercise the secp256k1 ECDSA *verification* path of
// the Compact standard library: the `Secp256k1EcdsaSignature` struct, the
// `Secp256k1Point` type, and the `secp256k1EcdsaVerify` circuit (see the secp
// section of `compiler/zkir-v3-library.compact` on the branch toolchain).
//
// `secp256k1EcdsaVerify(msgHash, sig, pk)` runs the standard ECDSA check
//   w  = s^-1; u1 = msgHash*w; u2 = r*w; P = u1*G + u2*pk; valid iff P.x == r
// over secp256k1, using the in-circuit elliptic-curve operations (`ecMul`,
// `ecMulGenerator`, `ecAdd`, `secp256k1PointX`, scalar `inv`).
//
// `msgHash` is taken as a `Bytes<32>` parameter (the big-endian SHA-256 / keccak
// digest a caller already has) rather than hashed in-circuit, so this contract
// isolates the *secp256k1* feature from `keccak256`.
//
// ENDIANNESS: an ECDSA message representative `e` is a BIG-endian integer, and
// `secp256k1EcdsaVerify` interprets `msgHash` big-endian for us: its internal
// `hashToSecp256k1Scalar` reverses the digest to the little-endian byte order the
// `as Secp256k1Scalar` cast reads. So the contract passes the big-endian
// `msgHash` STRAIGHT THROUGH — no in-circuit `reverseBytes32` (the std lib used
// to require the caller to pre-reverse; it no longer does). The JS driver stays
// natural: it passes `e = SHA-256(msg)` (big-endian) unchanged — the same bytes a
// reference verifier (e.g. @noble/curves) consumes.
//
// NOTE: this primitive is the *raw* ECDSA check — it has no low-s (malleability)
// enforcement, so it accepts both `s` and `n - s`. The Bitcoin "low-s only"
// policy is a wrapper concern (see the Wycheproof KAT's malleability carve-out).
//
// This is a PURE circuit (it touches no ledger state), so it is computed
// off-chain by the Compact JS runtime. Disclosing a value derived from witness
// parameters (here, the verification result) must be declared with `disclose`.
//
// MUST be compiled with `--feature-zkir-v3`. Unlike keccak256 (a builtin that is
// always in scope and only hits the v3 gate once it enters zkir), the secp256k1
// surface — the `Secp256k1Point` type, the signature structs, and the
// `secp256k1Ecdsa*` circuits — is defined in the compiler's
// `zkir-v3-library.compact`, which is loaded only when the v3 IR is enabled.
// Without the flag, `Secp256k1Point` is an `unbound identifier` even in a pure
// circuit.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit verifyEcdsa(
  msgHash: Bytes<32>,
  sig: Secp256k1EcdsaSignature,
  pk: Secp256k1Point
): Boolean {
  return disclose(secp256k1EcdsaVerify(msgHash, sig, pk));
}
