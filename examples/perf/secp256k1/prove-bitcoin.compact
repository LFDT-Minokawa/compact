//
// prove-bitcoin-secp256k1.compact — the FULL Bitcoin-style ECDSA flow, in-circuit:
// hash the raw message with SHA-256 and verify the signature.
//
// SHA-256 IN-CIRCUIT: Compact's `persistentHash<Bytes<N>>(msg)` is plain
// SHA-256 of the N message bytes. So unlike verify-secp256k1.compact
// — which takes a pre-hashed `msgHash` to isolate the secp256k1 primitive — this
// contract reproduces Wycheproof's `e = SHA-256(msg)` entirely on-circuit from the
// raw message.
//
// ENDIANNESS: persistentHash yields a big-endian digest, which is exactly what
// `secp256k1EcdsaVerify` now expects — it reverses the digest to little-endian
// internally (via its `hashToSecp256k1Scalar`) for the `as Secp256k1Scalar` cast.
//
// MUST be compiled with --feature-zkir-v3 (the secp256k1 surface lives in the
// compiler's zkir-v3 library). PURE circuits (no ledger): computed off-chain.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// Bitcoin-style verify for a 0-byte message: e = SHA-256(msg) in-circuit.
export circuit proveBitcoin0(
  msg: Bytes<0>,
  sig: Secp256k1EcdsaSignature,
  pk: Secp256k1Point
): Boolean {
  return disclose(secp256k1EcdsaVerify(persistentHash<Bytes<0>>(msg), sig, pk));
}

