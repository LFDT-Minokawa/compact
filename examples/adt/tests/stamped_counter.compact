import CompactStandardLibrary;

export ledger s: StampedCounter<Uint<64>>;

export circuit test_all(): [] {
  assert(s.value() == 0, "Initial value is 0");
  assert(!s.member(1), "Nothing is stamped");

  s.stamp(1);
  assert(s.member(1), "Key 1 is stamped");
  assert(s.lookup(1) == 0, "Key 1 was stamped with 0");

  s.increment(5);
  assert(s.value() == 5, "Value is 5");
  assert(s.lookup(1) == 0, "The stamp does not move");

  s.stamp(2);
  assert(s.lookup(2) == 5, "Key 2 was stamped with 5");

  s.raiseTo(3);
  assert(s.value() == 5, "Raising below the value is a no-op");
  s.raiseTo(9);
  assert(s.value() == 9, "Raising above the value takes the threshold");

  s.remove(1);
  assert(!s.member(1), "Key 1 is no longer stamped");
  assert(s.member(2), "Key 2 still is");

  s.resetToDefault();
  assert(s.value() == 0, "Value is 0");
  assert(!s.member(2), "Nothing is stamped");
}
