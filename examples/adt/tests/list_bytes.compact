import CompactStandardLibrary;

export ledger c: List<Bytes<128>>;

export circuit test(): [] {
  const zero = pad(128, "0");
  const one = pad(128, "1");

  assert(c.isEmpty() == true, "Structure should be empty");
  assert(c.length() == 0, "Size should be 0");
  assert(isNone<Bytes<128>>(c.head()), "Head should not exist");

  c.pushFront(zero);
  assert(c.length() == 1, "Size should be 1");
  assert(isSome<Bytes<128>>(c.head()), "Head should exist");
  assert(c.head() == some<Bytes<128>>(zero), "Head should have value 0");

  c.pushFront(one);
  assert(c.length() == 2, "Size should be 2");
  assert(isSome<Bytes<128>>(c.head()), "Head should exist");
  assert(c.head() == some<Bytes<128>>(one), "Head should have value 1");

  c.popFront();
  assert(c.length() == 1, "Size should be 1");
  assert(isSome<Bytes<128>>(c.head()), "Head should exist");
  assert(c.head() == some<Bytes<128>>(zero), "Head should have value 0");

  c.resetToDefault();
}
