import CompactStandardLibrary;

export ledger c: NumberedSet<QualifiedShieldedCoinInfo>;

export circuit test_QualifiedShieldedCoinInfo(): [] {
  const qcoin = QualifiedShieldedCoinInfo { pad(32, "nonce"), pad(32, "color"), 1, 0 };
  const qcoin2 = QualifiedShieldedCoinInfo { pad(32, "nonce"), pad(32, "color"), 2, 0 };

  assert(c.isEmpty(), "Structure should be empty");
  c.insert(qcoin);
  c.insert(qcoin2);
  assert(c.size() == 2, "Size should be 2");
  assert(c.lookup(qcoin) == 0, "qcoin should be numbered 0");
  assert(c.lookup(qcoin2) == 1, "qcoin2 should be numbered 1");

  c.resetToDefault();
  assert(c.isEmpty(), "Structure should be empty");
  assert(c == 0, "Counter should be 0");
}

export circuit test_ShieldedCoinInfo(): [] {
  const coin = ShieldedCoinInfo { pad(32, "nonce"), pad(32, "color"), 1 };
  const coin2 = ShieldedCoinInfo { pad(32, "nonce"), pad(32, "color"), 2 };
  const self = right<ZswapCoinPublicKey, ContractAddress>(kernel.self());

  c.resetToDefault();
  receiveShielded(coin);
  c.insertCoin(coin, self);
  receiveShielded(coin2);
  c.insertCoin(coin2, self);
  assert(c.size() == 2, "Size should be 2");
  c.insertCoin(coin, self);
  assert(c.size() == 2, "Inserting a present coin does not add one");
  assert(c == 2, "Counter should be 2: only the two new coins advanced it");
}
