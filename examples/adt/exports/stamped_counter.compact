import CompactStandardLibrary;

export ledger s: StampedCounter<Bytes<32>>;

export circuit stamp(key: Bytes<32>): [] {
  return s.stamp(disclose(key));
}

export circuit increment(amount: Uint<16>): [] {
  return s.increment(disclose(amount));
}

export circuit raise_to(threshold: Uint<64>): [] {
  return s.raiseTo(disclose(threshold));
}

export circuit remove(key: Bytes<32>): [] {
  return s.remove(disclose(key));
}

export circuit reset_to_default(): [] {
  return s.resetToDefault();
}

export circuit value(): Uint<64> {
  return s.value();
}

export circuit lookup(key: Bytes<32>): Uint<64> {
  return s.lookup(disclose(key));
}

export circuit member(key: Bytes<32>): Boolean {
  return s.member(disclose(key));
}
