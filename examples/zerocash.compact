export {zerocash_mint, spend, receive_coin, derive_zk_public_key}

import CompactStandardLibrary;

struct Nonce { bytes: Bytes<32>; }
struct opening { bytes: Bytes<32>; }
struct nullifier { bytes: Bytes<32>; }
struct zk_secret_key { bytes: Bytes<32>; }
struct zk_public_key { bytes: Bytes<32>; }
struct commitment { bytes: Bytes<32>; }

struct coin_info {
  nonce: Nonce;
  opening: opening;
}
struct public_key {
  zk: zk_public_key;
  encryption: Opaque<"Uint8Array">;
}

// the capsule secret: this wallet's zerocash key, and the seed of its fresh coins
host midnight:capsule/keys@1.0.0 { secretKey(): Bytes<32>; }
// encryption to a recipient is not Compact's to compute, therefore the DApp supplies it
host zerocash:dapp/encryption@1.0.0 { encrypt(pk: Opaque<"Uint8Array">, coin: coin_info): Opaque<"Uint8Array">; }

export ledger nullifiers: Set<nullifier>;
export ledger commitments: HistoricMerkleTree<32, commitment>;
  // This is a hack, really we want a Sink ADT that doesn't store anything.
export ledger ciphertexts: Opaque<"Uint8Array">;

// this wallet's unspent coins, kept off chain
export local coins: Set<coin_info>;
// how many coins this wallet has drawn, therefore each draw is fresh and replays in the fold
local drawn: Counter;

local my_secret_key(): zk_secret_key {
  return zk_secret_key{ bytes: secretKey() };
}

local new_coin_info(): coin_info {
  drawn.increment(1);
  const n = drawn.read() as Field as Bytes<32>;
  const sk = secretKey();
  return coin_info{
    nonce: Nonce{ bytes: persistentHash<Vector<3, Bytes<32>>>([pad(32, "lares:zerocash:nonce"), sk, n]) },
    opening: opening{ bytes: persistentHash<Vector<3, Bytes<32>>>([pad(32, "lares:zerocash:opening"), sk, n]) }
  };
}

// an off-chain search of the public tree; the circuit checks the root
local path_of(cm: commitment): MerkleTreePath<32, commitment> {
  const path = commitments.findPathForLeaf(cm);
  assert(path.is_some, "Commitment not in the public tree");
  return path.value;
}

circuit spend(dest_public_key: public_key, input_coin: coin_info): [] {
  // a private convenience check; the sound guard is the nullifier set
  assert(coins.member(input_coin), "spend: Not one of my coins");
  const source_secret_key = my_secret_key();
  const old_nullifier = derive_nullifier(input_coin, source_secret_key);
  assert(!nullifiers.member(old_nullifier), "spend: Coin already spent");
  nullifiers.insert(old_nullifier);
  const source_public_key = derive_zk_public_key(source_secret_key);
  const old_commitment = commitment_from_coin_info(input_coin, source_public_key);
  const commitment_path = path_of(old_commitment);
  assert(commitments.checkRoot(disclose(merkleTreePathRoot<32, commitment>(commitment_path))) &&
         old_commitment == commitment_path.leaf,
         "spend: Illegal state: merkle path not recognized by public state");
  const fresh_coin_info = new_coin_info();
  const fresh_commitment = commitment_from_coin_info(fresh_coin_info, dest_public_key.zk);
  commitments.insert(fresh_commitment);
  const ciphertext = disclose(encrypt(dest_public_key.encryption, fresh_coin_info));
  ciphertexts.write(ciphertext);
  coins.remove(input_coin);
}

circuit zerocash_mint(): [] {
  const coin = new_coin_info();
  const pk = derive_zk_public_key(my_secret_key());
  coins.insert(coin);
  const cm = commitment_from_coin_info(coin, pk);
  commitments.insert(cm);
}

// a coin another wallet sent, decrypted by the DApp, enters this wallet once its commitment is in
// the public tree; the circuit has no on-chain effect, so it is not proved
circuit receive_coin(coin: coin_info): [] {
  path_of(commitment_from_coin_info(coin, derive_zk_public_key(my_secret_key())));
  coins.insert(coin);
}


circuit derive_nullifier(coin: coin_info, sk: zk_secret_key): nullifier {
  return nullifier{ bytes: disclose(persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "lares:zerocash:commit"),
    coin.nonce.bytes,
    coin.opening.bytes,
    sk.bytes
  ]))};
}

circuit derive_zk_public_key(sk: zk_secret_key): zk_public_key {
  return zk_public_key{ bytes: persistentHash<Bytes<32>>(sk.bytes)};
}

circuit commitment_from_coin_info(coin: coin_info, pk: zk_public_key): commitment {
  return commitment{ bytes: disclose(persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "lares:zerocash:commit"),
    coin.nonce.bytes,
    coin.opening.bytes,
    pk.bytes
  ]))};
}
