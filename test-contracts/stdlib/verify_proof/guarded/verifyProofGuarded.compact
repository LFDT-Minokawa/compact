import CompactStandardLibrary;

export { verifyProofGuarded }

witness innerProof(): Opaque<"Uint8Array">;

export ledger attestedValue: Field;

// The same statement as `basic`, behind a guard. ZKIR emits one `inner_proof`
// instruction whatever the guard's value, but consumes a witness only where the
// guard is on -- so `verify` decides how many entries `innerProofs` carries.
circuit verifyProofGuarded(verify: Boolean, value: Field): [] {
    attestedValue = disclose(value);

    if (disclose(verify)) {
        verifyProof('basic.verifier', innerProof(), [attestedValue]);
    }
}
