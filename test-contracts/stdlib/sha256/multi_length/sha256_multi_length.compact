// persistentHash over the same input widths as the keccak256 sweep.
//
// persistentHash runs in the Rust runtime rather than in JavaScript, so the
// expected digests really are from a second implementation.
//
// All the circuits are pure, and persistentHash needs no feature flag.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// 1 = the minimal width: a single byte.
export circuit hashBytes1(value: Bytes<1>): Bytes<32> {
  return disclose(persistentHash<Bytes<1>>(value));
}

// 32..63 — EVERY width from the digest width (32) through one byte past the
// 2x31 = 62 field-element packing boundary (63); 33 is also the compressed
// secp256k1 public-key length.
export circuit hashBytes32(value: Bytes<32>): Bytes<32> {
  return disclose(persistentHash<Bytes<32>>(value));
}

export circuit hashBytes33(value: Bytes<33>): Bytes<32> {
  return disclose(persistentHash<Bytes<33>>(value));
}

