// 93 = 3x31: exactly three 31-byte field-element packing units.
export circuit hashBytes93(value: Bytes<93>): Bytes<32> {
  return disclose(persistentHash<Bytes<93>>(value));
}

// 94 = 3x31 + 1: one byte past the three-unit packing boundary.
export circuit hashBytes94(value: Bytes<94>): Bytes<32> {
  return disclose(persistentHash<Bytes<94>>(value));
}

// 376 = the CCTP V2 burn-message length (see dapps/usdcx).
export circuit hashBytes376(value: Bytes<376>): Bytes<32> {
  return disclose(persistentHash<Bytes<376>>(value));
}

// A deliberately large, multi-block input.
export circuit hashBytes1024(value: Bytes<1024>): Bytes<32> {
  return disclose(persistentHash<Bytes<1024>>(value));
}
