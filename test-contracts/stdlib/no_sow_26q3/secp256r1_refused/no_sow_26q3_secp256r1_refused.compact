import CompactStandardLibrary;

// Secp256r1 is 2026-Q3 functionality, so --no-sow-26q3 refuses its first use.
export pure circuit no_sow_26q3_secp256r1_refused(pk: Secp256r1Point): Secp256r1Point {
  return pk;
}
