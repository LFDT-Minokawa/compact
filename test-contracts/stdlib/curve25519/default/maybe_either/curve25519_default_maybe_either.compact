import CompactStandardLibrary;

export ledger point: Maybe<Curve25519Point>;

export ledger scalar: Maybe<Curve25519Scalar>;

export ledger base: Either<Curve25519Base, Field>;

// A Maybe or Either that holds no Curve25519 value still carries a default
// for the absent one, and the ZKIR backend must produce that default. The
// ledger writes make these circuits impure so that ZKIR is generated for
// them. They failed to compile with an internal error before issue #868 was
// fixed.
export circuit none_point(): Maybe<Curve25519Point> {
  point = none<Curve25519Point>();
  return point;
}

export circuit none_scalar(): Maybe<Curve25519Scalar> {
  scalar = none<Curve25519Scalar>();
  return scalar;
}

export circuit right_of_base(x: Field): Either<Curve25519Base, Field> {
  base = right<Curve25519Base, Field>(disclose(x));
  return base;
}
