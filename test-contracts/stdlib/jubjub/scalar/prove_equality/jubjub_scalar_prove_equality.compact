// From issue #757
pragma language_version >= 0.26.0;

import CompactStandardLibrary;

export ledger counter: Counter;

export circuit check(r: JubjubScalar): [] {
  assert(r != 0 as JubjubScalar, "zero");
  counter.increment(1);
}

// check with == in place of !=
export circuit checkEqual(r: JubjubScalar): [] {
  assert(r == 1 as JubjubScalar, "not one");
  counter.increment(1);
}
