import CompactStandardLibrary;

struct Entry {
  id: Uint<16>;
  scalar: JubjubScalar;
}

struct Outer {
  entries: Vector<2, Entry>;
  optional: Maybe<JubjubScalar>;
  flag: Boolean;
}

ledger encoded: Bytes<102>;
ledger decoded: Outer;

// Fields are laid out depth first, in declaration order: two entries of 2 + 32
// bytes, the Maybe as 1 + 32 bytes, then 1 byte for the Boolean.
export circuit serialize_outer(value: Outer): Bytes<102> {
  encoded = disclose(serialize<Outer, 102>(value));
  return encoded;
}

export circuit deserialize_outer(bytes: Bytes<102>): Outer {
  decoded = disclose(deserialize<Outer, 102>(bytes));
  return decoded;
}
