import CompactStandardLibrary;

export ledger encoded: Bytes<32>;
ledger padded: Bytes<40>;
ledger decoded: JubjubScalar;

// Stores the encoding, then decodes the stored bytes, so the value crosses the
// ledger as plain bytes.
export circuit serialize_roundtrip(value: JubjubScalar): JubjubScalar {
  encoded = disclose(serialize<JubjubScalar, 32>(value));
  decoded = deserialize<JubjubScalar, 32>(encoded);
  return decoded;
}

// With a length above 32, serialize puts zero bytes after the encoding.
export circuit serialize_padded(value: JubjubScalar): Bytes<40> {
  padded = disclose(serialize<JubjubScalar, 40>(value));
  return padded;
}

// With a length above 32, deserialize reads the first 32 bytes and ignores the
// rest, even when they are not zero.
export circuit deserialize_padded(bytes: Bytes<40>): JubjubScalar {
  decoded = disclose(deserialize<JubjubScalar, 40>(bytes));
  return decoded;
}
