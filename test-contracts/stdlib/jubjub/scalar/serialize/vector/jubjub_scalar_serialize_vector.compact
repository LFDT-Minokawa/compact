import CompactStandardLibrary;

ledger encoded: Bytes<96>;
ledger decoded: Vector<3, JubjubScalar>;

export circuit serialize_vector(values: Vector<3, JubjubScalar>): Bytes<96> {
  encoded = disclose(serialize<Vector<3, JubjubScalar>, 96>(values));
  return encoded;
}

export circuit deserialize_vector(bytes: Bytes<96>): Vector<3, JubjubScalar> {
  decoded = disclose(deserialize<Vector<3, JubjubScalar>, 96>(bytes));
  return decoded;
}
