import CompactStandardLibrary;

struct Entry {
  id: Uint<16>;
  scalar: JubjubScalar;
}

export circuit emit_entry(entry: Entry): [] {
  emit(Misc { name: pad(32, "jubjub-entry"), payload: disclose(serialize<Entry, 256>(entry)) });
}

export circuit decode_entry_event(data: Bytes<288>): Entry {
  const misc = deserialize<Misc, 288>(data);
  return disclose(deserialize<Entry, 256>(misc.payload));
}
