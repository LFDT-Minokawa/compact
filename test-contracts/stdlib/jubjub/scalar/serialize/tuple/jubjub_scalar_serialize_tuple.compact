import CompactStandardLibrary;

ledger encoded: Bytes<65>;
ledger decoded: [Field, JubjubScalar, Boolean];

export circuit serialize_tuple(value: [Field, JubjubScalar, Boolean]): Bytes<65> {
  encoded = disclose(serialize<[Field, JubjubScalar, Boolean], 65>(value));
  return encoded;
}

export circuit deserialize_tuple(bytes: Bytes<65>): [Field, JubjubScalar, Boolean] {
  decoded = disclose(deserialize<[Field, JubjubScalar, Boolean], 65>(bytes));
  return decoded;
}
