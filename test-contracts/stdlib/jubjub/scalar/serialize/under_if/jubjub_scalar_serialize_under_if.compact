import CompactStandardLibrary;

ledger encoded: Bytes<32>;
ledger decoded: JubjubScalar;

export circuit serialize_if(flag: Boolean, value: JubjubScalar): Bytes<32> {
  if (disclose(flag)) {
    encoded = disclose(serialize<JubjubScalar, 32>(value));
  }
  return encoded;
}

export circuit deserialize_if(flag: Boolean, bytes: Bytes<32>): JubjubScalar {
  if (disclose(flag)) {
    decoded = disclose(deserialize<JubjubScalar, 32>(bytes));
  }
  return decoded;
}
