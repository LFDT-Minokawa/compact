// The second report on issue #616
import CompactStandardLibrary;
ledger calls: Counter;
export circuit derivePk(ek: Bytes<32>): JubjubPoint {
  calls.increment(1);
  return disclose(ecMulGenerator(degradeToTransient(persistentHash<Vector<1, Bytes<32>>>([ek])) as JubjubScalar));
}

// From OpenZeppelin's ElGamal module
// contracts/src/crypto/ElGamal.compact.
module ElGamal {
  import CompactStandardLibrary;

  export pure circuit secretToScalar(secret: Bytes<32>): JubjubScalar {
    return degradeToTransient(persistentHash<Vector<1, Bytes<32>>>([secret])) as JubjubScalar;
  }

  export pure circuit derivePk(ek: Bytes<32>): JubjubPoint {
    return ecMulGenerator(secretToScalar(ek));
  }
}

import ElGamal prefix ElGamal_;
export circuit elGamalDerivePk(ek: Bytes<32>): JubjubPoint {
  calls.increment(1);
  return disclose(ElGamal_derivePk(ek));
}
