import CompactStandardLibrary;

// Casts a JubjubScalar value to a Boolean, which is a type error: only Field
// and Uint values cast to Boolean.
export circuit jubjub_scalar_casts_to_boolean(value: JubjubScalar): Boolean {
    return value as Boolean;
}
