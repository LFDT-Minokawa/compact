// The contract from issue #616, unchanged.
import CompactStandardLibrary;
ledger address: Bytes<20>;
export circuit test0(pt: Secp256k1Point): [] {
  assert(pt != default<Secp256k1Point>, "blah");
  address = disclose(slice<20>(keccak256<JubjubScalar>(0 as JubjubScalar), 0));
}

// test0 without its Secp256k1Point check
export circuit test0_minimal(): [] {
  address = disclose(slice<20>(keccak256<JubjubScalar>(0 as JubjubScalar), 0));
}
