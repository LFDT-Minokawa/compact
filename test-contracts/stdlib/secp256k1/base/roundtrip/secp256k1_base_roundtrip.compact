import CompactStandardLibrary;

export ledger stored: Secp256k1Base;

// A Secp256k1Base survives a round trip through the ledger.
//
// The value does not fit in a native field element, so writing it splits it
// across two field-aligned binary atoms -- 192 low-order bits then 64
// high-order bits -- and reading it back applies the inverse decoding. The
// assignment writes and the return reads, so both directions are exercised.
export circuit secp256k1_base_roundtrip(value: Secp256k1Base): Secp256k1Base {
    stored = disclose(value);
    return stored;
}
