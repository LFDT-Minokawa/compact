// The secp256k1 signature check.
//
// The digest is passed in rather than hashed here, so this covers only the
// curve maths. Hashing and checking together is ../bitcoin_kat.
//
// The digest goes in big-endian; the library flips it internally.
//
// Pure, so no keys are generated, but the v3 flag is still needed.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit verifyEcdsa(
    msgHash: Bytes<32>,
    sig: Secp256k1EcdsaSignature,
    pk: Secp256k1Point
): Boolean {
    return disclose(secp256k1EcdsaVerify(msgHash, sig, pk));
}
