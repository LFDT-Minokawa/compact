// The FULL Bitcoin-style ECDSA flow in-circuit: hash the raw message with
// SHA-256, then verify. `persistentHash<Bytes<N>>` is a plain SHA-256 of the N
// message bytes, so the circuit reproduces the corpus's `e = SHA-256(msg)`
// without any pre-hashing in JS. The companion ../ecdsa_verify feeds a
// pre-hashed digest instead, isolating the curve arithmetic; this one
// exercises hashing and verification together.
//
// FIXED-LENGTH MESSAGES: `Bytes<N>` is fixed-size and SHA-256 padding depends
// on the exact length, so there is one circuit per distinct message length in
// the Wycheproof corpus (0, 3, 5, 6, 7, 8, 9, 10, 11, 20 bytes) and the
// runtime test routes each vector to the matching circuit. A vector whose
// length has no circuit is reported rather than skipped, so a corpus refresh
// that adds a length cannot silently lose coverage.
//
// Pure -- no ledger write -- so despite the name nothing is proven here and no
// keys are generated; `--feature-zkir-v3` is still required for the library.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// 0-byte message.
export circuit proveBitcoin0(
    msg: Bytes<0>,
    sig: Secp256k1EcdsaSignature,
    pk: Secp256k1Point
): Boolean {
    return disclose(secp256k1EcdsaVerify(persistentHash<Bytes<0>>(msg), sig, pk));
}

// 3-byte message.
export circuit proveBitcoin3(
