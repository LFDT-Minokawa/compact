import CompactStandardLibrary;

export ledger verified: Boolean;

// secp256k1EcdsaVerify uses inv and secp256k1PointX, so inside an if it failed
// the proof check when the branch was not taken, before issue #867 was fixed.
export circuit secp256k1_guarded_ecdsa_verify(
                 b: Boolean,
                 digest: Bytes<32>,
                 sig: Secp256k1EcdsaSignature,
                 pk: Secp256k1Point
                 ): Boolean {
  if (disclose(b)) {
    verified = disclose(secp256k1EcdsaVerify(digest, sig, pk));
  }
  return verified;
}
