// Two and three signature checks in one circuit, to be sure repeating the
// gate does not upset the compiler.
//
// The ledger write makes them provable, so this generates keys and is slow.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger n: Uint<64>;

witness sigOf(i: Uint<8>): Secp256k1EcdsaSignature;
witness keyOf(i: Uint<8>): Secp256k1Point;

export circuit two(d: Bytes<32>): [] {
    const a = secp256k1EcdsaVerify(d, sigOf(0), keyOf(0));
    const b = secp256k1EcdsaVerify(d, sigOf(1), keyOf(1));
    n = disclose((a && b) ? 1 : 0);
}

export circuit three(d: Bytes<32>): [] {
    const a = secp256k1EcdsaVerify(d, sigOf(0), keyOf(0));
    const b = secp256k1EcdsaVerify(d, sigOf(1), keyOf(1));
    const c = secp256k1EcdsaVerify(d, sigOf(2), keyOf(2));
    n = disclose((a && b && c) ? 1 : 0);
}
