// The provable version of ../../ethereum_address: writing the address to the
// ledger means hashing a curve point has to survive zkir v3.
//
// That used to crash the compiler and was fixed in compact#612.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger lastAddr: Bytes<20>;

export circuit storeEthereumAddress(pk: Secp256k1Point): Bytes<20> {
    const addr = secp256k1EthereumAddress(pk);
    lastAddr = disclose(addr);
    return disclose(addr);
}
