import CompactStandardLibrary;

witness getPoint(): Secp256k1Point;

export ledger x: Secp256k1Base;

export ledger y: Secp256k1Base;

// In ZKIR, a witness that is not called gives the identity, which has no
// coordinates on a secp curve. Reading them on the side of a branch that is
// not taken failed the proof check before issue #867 was fixed.
export circuit secp256k1_point_guarded_coordinates(b: Boolean): [Secp256k1Base, Secp256k1Base] {
  if (disclose(b)) {
    const p = getPoint();
    x = disclose(secp256k1PointX(p));
    y = disclose(secp256k1PointY(p));
  }
  return [x, y];
}
