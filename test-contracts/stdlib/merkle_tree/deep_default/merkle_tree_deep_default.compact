import CompactStandardLibrary;

export ledger tree16: MerkleTree<16, Field>;

export ledger tree20: MerkleTree<20, Field>;

export ledger tree32: MerkleTree<32, Field>;

export ledger trees: Map<Boolean, MerkleTree<32, Field>>;

// Default MerkleTree values deeper than 15 failed to compile with an internal
// error before issue #879 was fixed. resetToDefault, insertDefault and
// inserting default<MerkleTree<32, Field>> each build a default tree in the
// circuit; depth 16 is the first that failed, 20 is in between and 32 is the
// deepest allowed.
export circuit insert(x: Field): [] {
  tree16.insert(disclose(x));
  tree20.insert(disclose(x));
  tree32.insert(disclose(x));
}

export circuit reset(): [] {
  tree16.resetToDefault();
  tree20.resetToDefault();
  tree32.resetToDefault();
}

export circuit insert_default(b: Boolean): [] {
  trees.insertDefault(disclose(b));
}

export circuit insert_default_value(b: Boolean): [] {
  trees.insert(disclose(b), default<MerkleTree<32, Field>>);
}
