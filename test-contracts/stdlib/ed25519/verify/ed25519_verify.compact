// The Ed25519 signature check over the Wycheproof corpus.
//
// The scheme hashes the message itself, so there is no pre-hashed variant.
// `Bytes<N>` is fixed-size, so there is one circuit per message length the
// corpus drives, and the runtime test reports a length with no circuit rather
// than skipping it.
//
// Pure, so no keys are generated, but the v3 flag is still needed.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit verifyEddsa0(
    msg: Bytes<0>,
    sig: Ed25519Signature,
    pk: Curve25519Point
): Boolean {
    return disclose(ed25519Verify<0>(msg, sig, pk));
}

