import CompactStandardLibrary;

export ledger stored: Curve25519Scalar;

// A Curve25519Scalar survives a round trip through the ledger: the assignment
// writes the two-atom encoding and the return reads it back.
//
// The scalar field is encoded differently from the base field, as 204 low
// bits then 51 high bits.
export circuit ed25519_scalar_roundtrip(value: Curve25519Scalar): Curve25519Scalar {
    stored = disclose(value);
    return stored;
}
