// keccak256 hashes all N bytes, including any zeros at the end.
//
// Older versions dropped those trailing zeros, which made a digest differ from
// the same bytes hashed anywhere else. The test would catch that coming back.
//
// One width is enough; the test varies the bytes. Pure, so no feature flag.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit hashBytes12(value: Bytes<12>): Bytes<32> {
    return disclose(keccak256<Bytes<12>>(value));
}
