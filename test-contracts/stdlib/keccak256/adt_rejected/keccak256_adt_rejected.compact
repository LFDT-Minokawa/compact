// keccak256 does not accept ledger types, so hashing a Counter is an error.
//
// Compiled with the v3 flag on purpose. Without it the missing keccak256 in
// zkir v2 would fail first and the test would pass for the wrong reason.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger hits: Counter;

export circuit keccak256_hashes_adt(): Bytes<32> {
    return disclose(keccak256<Counter>(hits));
}
