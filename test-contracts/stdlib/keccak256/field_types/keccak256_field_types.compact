// keccak256 over Field values rather than bytes.
//
// A Field becomes a fixed 32 bytes, little-endian, padded with zeros. So
// keccak256<Field>(0) hashes 32 zero bytes and is not the empty input, and
// each element of a vector keeps its own 32-byte slot.
//
// Both circuits are pure, so no feature flag is needed.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export circuit hashField(value: Field): Bytes<32> {
    return disclose(keccak256<Field>(value));
}

export circuit hashVector3(value: Vector<3, Field>): Bytes<32> {
    return disclose(keccak256<Vector<3, Field>>(value));
}
