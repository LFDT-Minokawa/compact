witness secret(): Boolean;

// A Boolean read from a vector element is not assumed to equal the first
// element, so the witness value returned in the else branch must be reported.
export circuit disclose_vector_element_condition(): Boolean {
  const values = [true, false, ...default<Vector<0, Boolean>>];
  return values[1] ? true : secret();
}
