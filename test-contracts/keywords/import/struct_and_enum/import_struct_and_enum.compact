module M {
  export struct Point {
    x: Field,
    y: Field
  }

  export enum Direction {
    North,
    South
  }

  export circuit make_point(x: Field, y: Field): Point {
    return Point { x, y };
  }

  export circuit flip(d: Direction): Direction {
    return d == Direction.North ? Direction.South : Direction.North;
  }
}

import { Point as Pt, Direction as Dir, make_point as mp, flip } from M;

// Imported struct and enum aliases are the same types the module's circuits accept and return.
export circuit import_struct_and_enum(): [Pt, Dir] {
  const p = mp(5 as Field, 10 as Field);
  assert(p == Pt { x: 5 as Field, y: 10 as Field }, "same Point type");
  return [p, flip(Dir.North)];
}
