module G<T> {
  export circuit first(v: Bytes<1>): T {
    return v[0] as T;
  }
}

module M {
  import { first as f } from G<Field>;
  import { first as f } from G<Uint<32>>;

  export circuit g(): Field {
    return f(Bytes[1]);
  }
}

// Importing two instantiations of a generic module under one alias makes calls ambiguous.
import { g } from M;
