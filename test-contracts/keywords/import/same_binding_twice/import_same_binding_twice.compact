module M {
  export circuit f(x: Field): Field {
    return x + 1;
  }
}

import { f as g } from M;

import { f as g } from M;

import { f as g, f as g } from M;

// Importing the same export under the same alias again is allowed.
export circuit import_same_binding_twice(): Field {
  return g(1 as Field);
}
