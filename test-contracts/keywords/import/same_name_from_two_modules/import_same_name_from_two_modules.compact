module A {
  export circuit process(x: Field): Field {
    return x + 10;
  }
}

module B {
  export circuit process(x: Field): Field {
    return x * 10;
  }
}

import { process as process_a } from A;

import { process as process_b } from B;

// Aliases let same-named exports from two modules be imported together.
export circuit import_same_name_from_two_modules(): [Field, Field] {
  return [process_a(5 as Field), process_b(5 as Field)];
}
