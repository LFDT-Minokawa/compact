module Unused<#N> {
  module Unused<T> {
    export circuit wrong(): [] {
      return "string";
    }

    export circuit also_wrong(v: Bytes<N>): T {
      return v;
    }
  }
}

// The body of a generic module that is never instantiated is not type-checked.
export circuit module_uninstantiated_generic_not_checked(): Boolean {
  return true;
}
