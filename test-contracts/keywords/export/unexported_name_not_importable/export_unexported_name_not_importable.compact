module A {
  export circuit f(x: Field): Field {
    return x;
  }

  export circuit k(x: Field): Field {
    return x;
  }
}

module B {
  import { f as g, k } from A;
  export { k };
}

import { k } from B;

// A module re-exports only the imported names it lists, so importing g from B is an error.
import { g } from B;
