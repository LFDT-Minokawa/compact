module M {
  witness secret(): Field;

  export circuit doubled_secret(): Field {
    return disclose(secret()) * 2;
  }
}

import { doubled_secret } from M;

// A witness declared in a module is supplied by the contract's witnesses.
export circuit modules_witness_in_module(): Field {
  return doubled_secret();
}
