module M {
  export circuit f(x: Field): Field {
    return x + 1;
  }
}

import { f as g } from M;

import { f as f } from M;

export { g };

// A selectively imported circuit is available under its alias, which may be its own name.
export circuit modules_import_renamed(): [Field, Field] {
  return [g(1 as Field), f(1 as Field)];
}
