module M {
  import { Maybe as ModMaybe } from CompactStandardLibrary;
  export { ModMaybe };
}

import { Maybe as Opt } from CompactStandardLibrary;

import { ModMaybe } from M;

// Names from CompactStandardLibrary can be imported selectively under aliases, in modules too.
export circuit modules_stdlib_selective_import(): Boolean {
  return default<Opt<Field>> == default<ModMaybe<Field>>;
}
