module M {
  export circuit f(x: Field): Field {
    return x + 1;
  }
}

import { f as a } from M;

import { f as b } from M;

// One export can be imported under several aliases that all name the same circuit.
export circuit modules_import_under_several_names(): [Field, Field] {
  return [a(1 as Field), b(1 as Field)];
}
