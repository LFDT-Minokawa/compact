type Bytes4 = Bytes<4>;

circuit takes_bytes(b: Bytes<4>): Bytes<4> {
  return b;
}

// A type alias is interchangeable with the type it names.
export circuit type_alias_interchangeable(v: Bytes4): Bytes<4> {
  const b: Bytes<4> = v;
  return takes_bytes(b);
}
