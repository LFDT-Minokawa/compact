type F1 = Field;

type F2 = F1;

new type N1 = Field;

new type N2 = N1;

// Aliases and new types can be defined in terms of other aliases and new types.
export circuit type_chained(a: F2, b: N2): [F1, Field] {
  return [a, b as N1 as Field];
}
