struct Reading {
  count: Count,
  tag: Tag
}

new type Count = Uint<32>;

type Tag = Bytes<4>;

type Total = Field;

// New types and aliases can be struct field types, even when declared after the struct.
export circuit type_in_struct(a: Reading, b: Reading): [Reading, Total] {
  const sum = Reading { count: a.count + b.count, tag: a.tag };
  return [sum, sum.count as Total];
}
