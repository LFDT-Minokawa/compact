type Pair<#A, #B> = [Vector<A, Field>, Bytes<B>];

new type Flags<#N> = Vector<N, Boolean>;

// Type aliases and new types can take generic size parameters.
export circuit type_generic(): [Pair<2, 1>, Flags<2>] {
  return [default<Pair<2, 1>>, default<Flags<2>>];
}
