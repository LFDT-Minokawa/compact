new type Count = Uint<16>;

// A new type keeps the comparison and arithmetic operations of its underlying type.
export circuit type_new_type_keeps_operations(a: Count, b: Count): [Boolean, Boolean, Field] {
  return [a > b, a != b, (a + b) as Field];
}
