// A const is allowed as a statement in braced for, if, else and lambda bodies.
export circuit const_in_braced_bodies(g: Boolean): Field {
  for (const i of 0..2) {
    const x = i;
  }
  const f = () => {
    const y = 2 as Field;
    return y;
  }();
  if (disclose(g)) {
    const a = 1 as Field;
    return a + f;
  } else {
    const b = 10 as Field;
    return b + f;
  }
}
