circuit zeros<#N>(): Vector<N, Field> {
  const v: Vector<N, Field> = default<Vector<N, Field>>, b: Bytes<N> = default<Bytes<N>>;
  return v;
}

// A const can be annotated with types that use a generic size parameter.
export circuit const_generic_type_annotation(): Vector<3, Field> {
  return zeros<3>();
}
