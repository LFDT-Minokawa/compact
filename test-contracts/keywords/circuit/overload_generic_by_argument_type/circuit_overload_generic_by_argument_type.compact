circuit pick<#N>(n: Uint<N>): Uint<8> {
  return 1;
}

circuit pick<#N>(b: Bytes<N>): Uint<8> {
  return 2;
}

// Generic overloads with the same generic parameters are chosen by argument type.
export circuit circuit_overload_generic_by_argument_type(): [Uint<8>, Uint<8>] {
  return [pick<8>(1 as Uint<8>), pick<8>(default<Bytes<8>>)];
}
