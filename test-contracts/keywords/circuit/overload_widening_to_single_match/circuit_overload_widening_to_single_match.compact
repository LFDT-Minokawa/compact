circuit pick<#N>(v: Vector<N, Uint<8>>): Uint<8> {
  return 8;
}

circuit pick<#N>(v: Vector<N, Uint<16>>): Uint<8> {
  return 16;
}

circuit pick<#N>(v: Vector<N, Uint<32>>): Uint<8> {
  return 32;
}

// An argument that widens to exactly one overload's parameter type selects that overload.
export circuit circuit_overload_widening_to_single_match(): Uint<8> {
  return pick<1>(default<Vector<1, Uint<24>>>);
}
