circuit pick<#N>(v: Vector<N, Uint<8>>): Boolean {
  return true;
}

circuit pick<#N>(v: Vector<N, Uint<16>>): Boolean {
  return false;
}

// An argument that widens to several overloads' parameter types makes the call ambiguous.
export circuit circuit_overload_ambiguous_by_widening(): Boolean {
  return pick<1>(default<Vector<1, Uint<1>>>);
}
