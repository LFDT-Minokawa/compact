circuit pick(n: Uint<8>): Boolean {
  return true;
}

circuit pick(n: Uint<8>): Field {
  return 1 as Field;
}

// Overloads that differ only in their return type make a call ambiguous.
export circuit circuit_overload_return_type_does_not_disambiguate(): Boolean {
  return pick(1);
}
