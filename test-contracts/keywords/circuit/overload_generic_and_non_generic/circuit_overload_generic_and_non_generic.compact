circuit pick(n: Field): Uint<8> {
  return 1;
}

circuit pick<T>(n: T): Uint<8> {
  return 2;
}

// A call without generic arguments picks the non-generic overload, and one with them picks the generic overload.
export circuit circuit_overload_generic_and_non_generic(): [Uint<8>, Uint<8>] {
  return [pick(1 as Field), pick<Field>(1 as Field)];
}
