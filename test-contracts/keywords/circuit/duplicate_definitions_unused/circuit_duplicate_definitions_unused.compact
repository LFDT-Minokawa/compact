circuit last<#N>(bytes: Bytes<N>): Uint<8> {
  return bytes[N - 1];
}

circuit last<#N>(bytes: Bytes<N>): Uint<8> {
  return bytes[N - 1];
}

circuit last<#N, T>(bytes: Bytes<N>, t: T): Uint<8> {
  return 7;
}

// Identical overload definitions are allowed while no call is ambiguous between them.
export circuit circuit_duplicate_definitions_unused(): Uint<8> {
  return last<8, Field>(default<Bytes<8>>, 1 as Field);
}
