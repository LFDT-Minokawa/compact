circuit pick<#N>(v: Vector<N, Field>): Uint<8> {
  return 1;
}

circuit pick<T>(v: T): Uint<8> {
  return 2;
}

// Generic overloads are chosen by whether the generic argument is a size or a type.
export circuit circuit_overload_by_generic_parameter_kind(): [Uint<8>, Uint<8>] {
  return [pick<3>(default<Vector<3, Field>>), pick<Field>(1 as Field)];
}
