import CompactStandardLibrary;

module One {
  include 'lib/shared';
}

module Two {
  include 'lib/shared';
}

import One prefix A_;

import Two prefix B_;

// Including the same file into two modules gives each module its own copy of its contents.
export circuit include_same_file_in_two_modules(): [Uint<64>, Uint<64>] {
  A_bump();
  B_bump();
  B_bump();
  return [A_counter.read(), B_counter.read()];
}
