// Unreachable statements are detected inside lambda bodies, including within if branches.
export circuit control_flow_return_unreachable_in_lambda_branch(b: Boolean): Field {
  return ((c: Boolean): Field => {
    if (c) {
      {
        return 1 as Field;
      }
      return 2 as Field;
    } else {
      return 3 as Field;
    }
  })(b);
}
