import CompactStandardLibrary;

ledger x: Field;

export ledger y: Boolean;

export ledger set: Set<Field>;

export ledger caroline: List<Boolean>;

constructor() {
  const p = anton(1 as Field);
  graham(true);
  andy(1 as Field, 2 as Field);
}

circuit anton(a: Field): [Field, Field] {
  x = disclose(a);
  return [x - a, x - a];
}

circuit graham(b: Boolean): [] {
  return true ? set.insert(b as Field) : set.insert(b as Field);
}

circuit andy(a: Field, b: Field): [Field, Field] {
  x = disclose(a) + disclose(b);
  return [x, x];
}

// Each branch of an if/else whose condition comes from a ledger ADT read can read and write the same ledger field.
export circuit control_flow_if_branches_write_ledger(a: Boolean): Boolean {
  caroline.pushFront(disclose(a));
  const p = caroline.head().value;
  if (p) {
    y = p || y;
  } else {
    y = p && y;
  }
  return y;
}
