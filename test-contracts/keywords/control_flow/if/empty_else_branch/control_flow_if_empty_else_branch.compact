export ledger count: Field;

// An if/else with an empty else branch runs whichever branch the condition selects.
export circuit control_flow_if_empty_else_branch(a: Boolean): Field {
  if (disclose(a)) {
    count = 1 as Field;
  } else {
  }
  return count;
}
