import CompactStandardLibrary;

module One {
  include 'lib/one';
}

module Two {
  include 'lib/two';
}

import One prefix A_;

import Two prefix B_;

// Same-named ledger fields from different modules coexist when the modules are imported with different prefixes.
export circuit prefix_avoids_name_collision(): [Uint<64>, Uint<64>] {
  A_bump();
  B_bump();
  return [A_counter.read(), B_counter.read()];
}
