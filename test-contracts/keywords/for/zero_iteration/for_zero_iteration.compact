export ledger total: Field;

// A for loop over an empty range or an empty tuple never runs its body.
export circuit for_zero_iteration(): Field {
  for (const i of 0..0) {
    total = total + 1;
  }
  for (const x of []) {
    total = total + 1;
  }
  return total;
}
