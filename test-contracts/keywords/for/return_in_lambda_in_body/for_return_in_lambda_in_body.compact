// A return inside a lambda in a for body returns from the lambda, not the circuit.
export circuit for_return_in_lambda_in_body(): Uint<16> {
  for (const i of 3..4) {
    const s = (() => {
      return i + 1;
    })();
  }
  return 7;
}
