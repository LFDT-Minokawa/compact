export ledger total: Uint<16>;

circuit sum_range<#S, #E>(v: Vector<4, Uint<8>>): Uint<16> {
  total = 0;
  for (const i of S..E) {
    total = (total + (v[i] as Uint<16>)) as Uint<16>;
  }
  return total;
}

// A for range can use generic size parameters as its bounds.
export circuit for_generic_bound(): Uint<16> {
  return sum_range<1, 3>([1, 2, 3, 4]);
}
