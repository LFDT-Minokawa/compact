import CompactStandardLibrary;

// Each result below always fits its type, so the compiler adds no range check.
new type Bit = Uint<1>;
new type BitRange = Uint<0..2>;
new type Zero = Uint<0..1>;

export circuit mul_bit(x: Bit, y: Bit): Bit {
    return x * y;
}

export circuit mul_bit_range(x: BitRange, y: BitRange): BitRange {
    return x * y;
}

export circuit add_zero(x: Zero, y: Zero): Zero {
    return x + y;
}

export circuit mul_zero(x: Zero, y: Zero): Zero {
    return x * y;
}

export circuit sub_bit(x: Bit, y: Bit): Bit {
    return x - y;
}
